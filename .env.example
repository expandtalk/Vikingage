# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# OpenRouter API key is set as a Supabase secret (server-side only):
#   supabase secrets set OPENROUTER_API_KEY=sk-or-...
# Do NOT add it here — it must never be exposed to the browser.

# Google Maps API (optional - for geolocation)
# Get your key from: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# Lantmäteriet Geotorget (optional - for admin boundary ingest)
# Requires authorization ordered on Geotorget. Use Basic (user+pass) OR OAuth2 (token).
LM_USER=""
LM_PASS=""
# LM_TOKEN=""   # OAuth2 Bearer, preferred over LM_USER/LM_PASS if available

# Lantmäteri Topografisk webbkarta Visning (CC0) — svensk topo-baskarta i kartorna (valfritt).
# Beställs separat på Geotorget. Sätt WMTS-tile-mallen (inkl. ev. token/nyckel) → LM-valen dyker
# upp i baskarte-väljaren automatiskt (src/config/basemaps.ts). {z}/{y}/{x} eller {z}/{x}/{y}
# beroende på tjänsten. Är token hemlig → peka mot en edge-proxy i st.f. direkt Lantmäteri-URL.
# VITE_LM_TOPO_GRAY_URL=""    # nedtonad gråskala (rekommenderad dämpad baskarta under datalagren)
# VITE_LM_TOPO_COLOR_URL=""   # färgversion
