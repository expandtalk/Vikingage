Options -MultiViews
RewriteEngine On

# Tvinga HTTPS (säkerhet + kanonisk URL; Screaming Frog flaggade http://-varianter). Först av allt.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Kanonisk värd: tvinga icke-www. Annars ligger inloggnings-sessionen i localStorage på
# fel origin (www.vikingage.se ≠ vikingage.se) och man ser utloggad ut. En origin = en session.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /welcome var en dublett av startsidan — permanent redirect (SEO: en kanonisk URL)
RewriteRule ^welcome/?$ / [R=301,L]

# Servera EXISTERANDE fil/katalog först (prerendrade sidor: /sv/birka/index.html m.fl. — Fas B).
# !-d är nytt: utan det bypassar SPA-fallbacken de prerendrade katalog-sidorna. Rena SPA-routes
# (utan prerender, t.ex. /explore) faller fortfarande igenom till index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Hashade assets (index-ABC123.js) får cachas hårt — filnamnet ändras vid ny build
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html får ALDRIG cachas — annars pekar den på gamla chunk-namn (1002/497-synvillan)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
