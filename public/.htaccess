Options -MultiViews
RewriteEngine On

# HTTPS tvingas INTE här: webbhotellet termineras TLS av en proxy → %{HTTPS} är alltid "off" även för
# https-anrop, så en villkorslös https-redirect blev en oändlig loop (ERR_TOO_MANY_REDIRECTS, 2026-08-19).
# HTTPS hanteras av hotellets proxy/cert. (Ev. framtida: redirect via %{HTTP:X-Forwarded-Proto}=http.)

# Kanonisk värd: tvinga icke-www. Annars ligger inloggnings-sessionen i localStorage på
# fel origin (www.vikingage.se ≠ vikingage.se) och man ser utloggad ut. En origin = en session.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /welcome var en dublett av startsidan — permanent redirect (SEO: en kanonisk URL)
RewriteRule ^welcome/?$ / [R=301,L]

# Utflyktslistan: svensk URL flyttad /sv/utflykter → /utflykter (kanonisk, utan /sv-prefix).
RewriteRule ^sv/utflykter/?$ /utflykter [R=301,L]

# Utflykter: SEO-slug-byten (id → ämnesspeglande slug). Hård 301 för crawlers; klienten redirectar
# dessutom mjukt (ExcursionDetail). En rad per byte, per språkbas.
RewriteRule ^excursions/haga/?$ /excursions/hagahogen [R=301,L]
RewriteRule ^utflykter/haga/?$ /utflykter/hagahogen [R=301,L]
